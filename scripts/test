#!/usr/bin/env bash
# Modified by PastureStack in 2026: module verification, unit, race, and coverage tests.
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
work_root="$(mktemp -d)"
cleanup()
{
    rm -rf "${work_root}"
}
trap cleanup EXIT

"${repo_root}/scripts/verify-go-toolchain"

(
    cd "${repo_root}"
    go mod verify
    CGO_ENABLED=1 go test \
        -mod=readonly \
        -count=1 \
        -race \
        ./...

    critical_cover_packages='./backends/...,./command,./pkg/...,./secrets,./service'
    go test \
        -mod=readonly \
        -count=1 \
        -covermode=atomic \
        -coverpkg="${critical_cover_packages}" \
        -coverprofile="${work_root}/coverage.out" \
        ./backends/... ./command ./pkg/... ./secrets ./service

    coverage="$(go tool cover -func="${work_root}/coverage.out" \
        | awk '/^total:/ { gsub(/%/, "", $3); print $3 }')"
    minimum_coverage='70.0'
    if ! awk -v actual="${coverage}" -v minimum="${minimum_coverage}" \
        'BEGIN { exit !(actual + 0 >= minimum + 0) }'; then
        printf 'Critical-path coverage %s%% is below the required %s%%.\n' \
            "${coverage}" "${minimum_coverage}" >&2
        exit 1
    fi
    printf 'Critical-path coverage: %s%% (required: %s%%)\n' \
        "${coverage}" "${minimum_coverage}"
)
