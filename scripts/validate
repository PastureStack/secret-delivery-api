#!/usr/bin/env bash
# Modified by PastureStack in 2026: current Go vet and formatting checks.
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
"${repo_root}/scripts/verify-go-toolchain"

(
    cd "${repo_root}"
    go mod verify
    go mod tidy -diff
    CGO_ENABLED=0 go vet -mod=readonly ./...
)

mapfile -t unformatted < <(find "${repo_root}" \
    -path "${repo_root}/.git" -prune -o \
    -path "${repo_root}/bin" -prune -o \
    -path "${repo_root}/dist" -prune -o \
    -name '*.go' -type f -print | xargs gofmt -l)
if (( ${#unformatted[@]} > 0 )); then
    printf 'Unformatted Go source:\n%s\n' "${unformatted[@]}" >&2
    exit 1
fi
