#!/usr/bin/env bash
# Modified by PastureStack in 2026: deterministic Go module build.
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
source "${repo_root}/scripts/version"

"${repo_root}/scripts/verify-go-toolchain"
mkdir -p "${repo_root}/bin"

(
    cd "${repo_root}"
    go mod verify
    CGO_ENABLED=0 \
    go build \
        -mod=readonly \
        -trimpath \
        -buildvcs=false \
        -tags "netgo osusergo" \
        -ldflags "-buildid= -s -w -X main.VERSION=${VERSION}" \
        -o "${repo_root}/bin/secret-delivery-api" .
)
